# Copy to .env and adjust. .env is gitignored.

DATABASE_URL=postgresql+psycopg://deploywatch:deploywatch@localhost:5433/deploywatch

# Max simultaneous outbound HTTP checks across ALL monitors. This is the
# semaphore bound in checker/engine.py -- the number that keeps 500 monitors
# the same process shape as 5.
CHECKER_CONCURRENCY=50

# Consecutive failing checks before an incident opens, and consecutive
# passing checks before it closes. Asymmetric on purpose: open slowly so one
# blip is not an incident, close slowly so a flapping service does not spam.
INCIDENT_OPEN_AFTER=3
INCIDENT_CLOSE_AFTER=2

# Where the frontend runs, for CORS.
CORS_ORIGINS=http://localhost:5173

# v2 -- Mailpit from docker-compose. Nothing reads these yet.
SMTP_HOST=localhost
SMTP_PORT=1025
ALERT_FROM=alerts@deploywatch.local

# Auth -- Supabase. Empty SUPABASE_URL = auth off (everyone is the owner).
SUPABASE_URL=
OWNER_USER_ID=
# Only for older Supabase projects that sign tokens with a shared secret.
SUPABASE_JWT_SECRET=
# Local dev monitors localhost; production must not.
ALLOW_PRIVATE_TARGETS=true
